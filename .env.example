# Workhorse environment variables
#
# Copy this file to .env and customize for your environment.
# The .env file is gitignored and will not be committed.
#
# Prefix every variable with the env_prefix from .fulmen/app.yaml.
# After CDRL refit, rename ROAN_ to your prefix (example: MYAPI_).
#
# Sensitive values (TOKEN, SECRET, PASSWORD, KEY) are masked in
# diagnostic output (`envinfo`, `doctor`).

# ─── Application / Server ───────────────────────────────────────────
#
# Canonical                         Alias
# ROAN_SERVER_HOST                  ROAN_HOST
# ROAN_SERVER_PORT                  ROAN_PORT

ROAN_PORT=8080
ROAN_HOST=127.0.0.1

# Required to bind a non-loopback address. POST /admin/signal is only
# served on a loopback listener when this is set. Do not commit the value.
# ROAN_ADMIN_TOKEN=

# ─── Logging ────────────────────────────────────────────────────────
#
# Canonical                         Alias
# ROAN_LOGGING_LEVEL                ROAN_LOG_LEVEL
# ROAN_LOGGING_PROFILE              ROAN_LOG_PROFILE

ROAN_LOG_LEVEL=info
# Options: trace, debug, info, warn, error
# ROAN_LOG_PROFILE=STRUCTURED
# Options: SIMPLE, STRUCTURED

# ─── Metrics and Health ─────────────────────────────────────────────

ROAN_METRICS_ENABLED=true
ROAN_METRICS_PORT=8080
ROAN_HEALTH_ENABLED=true

# ─── Server Timeouts ────────────────────────────────────────────────

ROAN_READ_TIMEOUT=30s
ROAN_WRITE_TIMEOUT=30s
ROAN_IDLE_TIMEOUT=120s
ROAN_SHUTDOWN_TIMEOUT=10s

# ─── Configuration File Path ────────────────────────────────────────
#
# If not set, uses the Config Path API: ~/.config/{config_name}/config.yaml
# ROAN_CONFIG_PATH=./config/roan/v1.0.0/roan-defaults.yaml
